<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>NotoriousGarden.Gameplay</AssemblyName>
    <!-- Unity assigns serialized fields and keeps unused design data. These are not compile failures in the editor. -->
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityShims\UnityShims.csproj" />
    <Compile Include="..\..\Assets\Notorious_Garden\Scripts\*.cs" />
  </ItemGroup>
</Project>
